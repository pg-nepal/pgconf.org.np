{% extends 'base.djhtml' %}
{% set pageTitle = 'Registration' %}


{% block main_content %}
<!-- <div class="content-container"> -->

    <div style="margin-bottom: 0.5rem;">
        <h2>🛑 Registration Not Open Yet !</h2>
        <p>
            Thank you for your interest in the next conference. Registration is not yet open.
        </p>

    </div>


    <div class="alert alert-info">

        <h2>🔮 Looking Ahead</h2>
        <p>We're grateful for the incredible energy and turnout this year. Planning for next year is already underway, and
            we aim to make it even bigger and better. Stay tuned for announcements about PGConf 2026!</p>
    </div>

    <h4 style="color: #007bff;"><em>For sponsorship inquiries or ticket purchases, please contact us!</em></h4>
<!-- </div> -->
{% endblock %}
