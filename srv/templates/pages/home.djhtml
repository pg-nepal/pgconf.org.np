{% extends 'base.djhtml' %}
{% set pageTitle = '/ Home' %}


{% block head %}
    <link rel="stylesheet" href="/static/css/home.css">
    <script src="/static/js/slider.js"></script>

    <style>
        @media (max-width: 700px) {
            .alert {
                display: flex;
                flex-direction: column;
                justify-content: center;
                align-items: center;
                padding: 1.5rem;
            }

            .alert .button {
                width: 100%;
                text-align: center;
            }
        }
        .left-content > section > h2::before {
            content : "🐘 ";
        }
    </style>
{% endblock %}


{% block jumbotron %}{% endblock %}


{% block main %}
    <div class="banner-container">
        <div class="overlay"></div>
        <div class="text">
            <h1><span style="color: #007bff; text-shadow: 0px 0px 5px black;">PostgreSQL</span> Conference Nepal, 2026</h1>
            <h2>18-21 Nov 2026</h2>
            <p>Pre-Conference Training &nbsp;&nbsp;|&nbsp;&nbsp; Main Conference (Workshop , Talk)</p>

        </div>
    </div>

    <div class="content-container">
        <div class="content">
            <div class="left-content">
                <section>
                    <h2><span style="color: #007bff;">PostgreSQL</span> Conference Nepal</h2>
                    <p>
                        We are thrilled to invite you to the fourth PostgreSQL Conference, taking place on <b>18-21 Nov 2026</b> in Nepal.
                        Building on the success of the inaugural PostgreSQL Conference Nepal held on 5-6 May 2025, 11-12 May 2023 and 4-5 May
                        2018, this year’s event promises to be even more engaging and inspiring.
                    </p>

                    <p>
                        The 2025, 2023, 2018 conference featured captivating talks and hands on training by internationally renowned
                        PostgreSQL experts alongside insightful contributions from talented local speakers. This year, we aim
                        to uphold this tradition, bringing together the global PostgreSQL community and local enthusiasts for
                        two days of knowledge sharing, networking, and collaboration.
                    </p>

                    <h4 style="font-style: italic">
                        Join us in celebrating and advancing the PostgreSQL ecosystem!
                    </h4>
                </section>

                <section id="sponsors" class="alert home-content mt-1">
                    <h2 class="section-header">
                        Organizers
                    </h2>

                    <div class="sponsors-logos">
                        <a href="https://postgrespro.com" target="_blank">
                            <img src="/static/sponsors/PostgresPro_logo.png" alt="Postgres Professional">
                        </a>
                        <a href="https://ku.edu.np" target="_blank">
                            <img src="/static/sponsors/ku-logo.png" alt="Kathmandu University">
                        </a>
                    </div>
                </section>

                <section id="sponsors" class="alert home-content mt-1">
                    <h2 class="section-header">
                        Sponsors
                    </h2>

                    <p>
                        For sponsorship contact: info@pgconf.org.np
                    </p>
                </section>
                <section id="sponsors" class="alert home-content mt-1">
                    <h2 class="section-header">
                        Supported By
                    </h2>

                    <p>To support us contact: info@pgconf.org.np</p>
                </section>
            </div>

            <div class="right-content">
                {% include '/sidebar.djhtml' %}
            </div>
        </div>
    </div>
{% endblock %}
